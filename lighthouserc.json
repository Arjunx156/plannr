{
  "ci": {
    "collect": {
      "startServerCommand": "bun x vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "4173",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/guides",
        "http://localhost:4173/tools/festival-checklist"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
