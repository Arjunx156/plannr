{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",

    // Every export in the app states its own types, so a reader never has to infer a module's contract.
    // The server can't: Drizzle's table types are thousands of lines when written out.
    "declaration": true,
    "isolatedDeclarations": true
  },
  "include": ["src"]
}
