# Copy to .env.local (git-ignored) and fill in. Read only on the server: never prefix with VITE_.
# Everything is optional for local development: without a key the AI features stay off, and the
# database runs in memory. See "Environment" in README.md for the production variables.

# Turns on the AI routes.
GEMINI_API_KEY=
# Optional overrides. Defaults: gemini-3.5-flash, then gemini-3.5-flash-lite when the first is busy.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
